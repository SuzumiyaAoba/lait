{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuzumiyaAoba/lait/master/schemas/workflow.json",
  "title": "lait workflow.yml",
  "description": "A lait workflow file, version 2: declared inputs, reusable definitions, and a list of steps, each with exactly one kind. See docs/usage/ja/workflow.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "Schema version. Omit for the latest version this build supports."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/inputDefinition"
      }
    },
    "input_schema": {
      "description": "Schema of the initial value (PROMPT, a caller's step input, or a test definition's input). PROMPT text is parsed as JSON unless the schema's type is 'string'.",
      "oneOf": [
        {
          "type": "string",
          "description": "A name defined in 'schemas:'."
        },
        {
          "$ref": "#/$defs/schemaSource"
        }
      ]
    },
    "output": {
      "type": "string",
      "description": "jq expression computing the workflow's result from the last value."
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "Wall-clock limit (seconds) for one run of this file."
    },
    "default": {
      "$ref": "#/$defs/workflowDefaults"
    },
    "models": {
      "$ref": "#/$defs/modelMap"
    },
    "schemas": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/schemaSource"
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/inlineAgent"
      }
    },
    "steps": {
      "$ref": "#/$defs/stepList"
    }
  },
  "$defs": {
    "reasoningEffort": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "retryDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "delay_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "backoff": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "commandSpec": {
      "description": "A shell-interpreted string, or a literal argv list run with no shell.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "providerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url"
      ],
      "not": {
        "required": [
          "api_key",
          "api_key_cmd"
        ]
      },
      "properties": {
        "base_url": {
          "type": "string"
        },
        "api_key": {
          "type": "string"
        },
        "api_key_cmd": {
          "$ref": "#/$defs/commandSpec"
        }
      }
    },
    "pricing": {
      "description": "USD per 1,000,000 prompt/completion tokens, for --show-usage/lait compare to estimate cost. Only the primary (first) models: entry's pricing is ever consulted, the same as default_reasoning_effort/etc.",
      "type": "object",
      "additionalProperties": false,
      "required": ["input_per_1m", "output_per_1m"],
      "properties": {
        "input_per_1m": { "type": "number", "minimum": 0 },
        "output_per_1m": { "type": "number", "minimum": 0 }
      }
    },
    "modelDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id"
      ],
      "properties": {
        "provider": { "$ref": "#/$defs/providerConfig" },
        "model_id": { "type": "string" },
        "default_reasoning_effort": { "$ref": "#/$defs/reasoningEffort" },
        "default_temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "default_top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "default_max_tokens": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "pricing": { "$ref": "#/$defs/pricing" },
        "api": { "type": "string", "enum": ["chat_completions", "responses"] }
      }
    },
    "modelMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/modelDefinition"
        },
        "minItems": 1
      }
    },
    "schemaSource": {
      "description": "An inline JSON Schema, or {file: path} (relative to the file it is written in).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": [
            "object",
            "boolean"
          ],
          "not": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {}
            }
          }
        }
      ]
    },
    "inputDefinition": {
      "description": "A JSON Schema for the input (an entry with 'default' is optional), or a type name shorthand.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflowDefaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fallback settings for LLM steps (prompt/agent).",
      "properties": {
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system": {
          "type": "string",
          "description": "Default system prompt for prompt steps."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inlineAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_schema": {
          "$ref": "#/$defs/schemaSource"
        },
        "output_schema": {
          "$ref": "#/$defs/schemaSource"
        },
        "schema_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "system": {
          "type": "string",
          "description": "System prompt template."
        }
      },
      "dependentRequired": {
        "schema_name": [
          "output_schema"
        ]
      }
    },
    "promptStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "description": "User message template (an LLM call)."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        },
        "system": {
          "type": "string",
          "description": "A handlebars template."
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Text files appended to the user message (templates; relative to the current directory)."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Image paths or http(s) URLs (templates)."
        },
        "input_schema": {
          "oneOf": [
            {
              "type": "string",
              "description": "A name defined in 'schemas:'."
            },
            {
              "$ref": "#/$defs/schemaSource"
            }
          ]
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "string",
              "description": "A name defined in 'schemas:'."
            },
            {
              "$ref": "#/$defs/schemaSource"
            }
          ]
        },
        "schema_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "dependentRequired": {
        "schema_name": [
          "output_schema"
        ]
      }
    },
    "agentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "An 'agents:' name, a lait.config.yml 'agents:' name, or a path to an agent Markdown file (relative to this workflow)."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_tool_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Text files appended to the user message (templates; relative to the current directory)."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Image paths or http(s) URLs (templates)."
        }
      }
    },
    "runStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Program and arguments (templates), executed without a shell.",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "\\S"
            }
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "description": "A path to a workflow file (relative to this workflow) or a lait.config.yml 'workflows:' name."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        },
        "with": {
          "type": "string",
          "description": "jq expression producing the child's inputs object."
        }
      }
    },
    "jqStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jq"
      ],
      "properties": {
        "jq": {
          "type": "string",
          "description": "A jq expression."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        }
      }
    },
    "askStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ask"
      ],
      "properties": {
        "ask": {
          "type": "string",
          "description": "Question shown to the user.",
          "minLength": 1,
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default": {
          "type": "string"
        },
        "multiline": {
          "type": "boolean"
        }
      }
    },
    "writeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write"
      ],
      "properties": {
        "write": {
          "type": "string",
          "minLength": 1,
          "description": "Destination path template (relative to the current directory)."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        }
      }
    },
    "groupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group"
      ],
      "properties": {
        "group": {
          "$ref": "#/$defs/stepList"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "description": "Records this step's value as steps.<id> / $steps.<id>; unique within the file."
        },
        "when": {
          "type": "string",
          "description": "jq condition on the incoming value; falsy skips the step."
        },
        "input": {
          "type": "string",
          "description": "jq expression computing the value the step acts on (default '.')."
        },
        "output": {
          "type": "string",
          "description": "jq expression mapping the step's result to its value."
        },
        "retry": {
          "$ref": "#/$defs/retryDefinition"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-attempt timeout in seconds."
        },
        "on_error": {
          "$ref": "#/$defs/stepList",
          "description": "Runs with {error, input} in place of failing."
        }
      }
    },
    "switchStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switch"
      ],
      "properties": {
        "switch": {
          "type": "array",
